# engine/ is a public repo. Whitelist only: everything is ignored unless listed below.
# Add new files one by one. Never re-include a whole folder (no `!/dir/**`).

/*
!/.gitignore
!/LICENSE
!/README.md
!/pyproject.toml

!/brain/
/brain/*
!/brain/__init__.py
!/brain/__main__.py
!/brain/app.py
!/brain/auth.py
!/brain/context.py
!/brain/install.py
!/brain/mcp.py
!/brain/store.py

!/brain/web/
/brain/web/*
!/brain/web/__init__.py
!/brain/web/api.py

!/brain/web/static/
/brain/web/static/*
!/brain/web/static/app.js
!/brain/web/static/icon.svg
!/brain/web/static/index.html
!/brain/web/static/style.css

!/brain/web/static/vendor/
/brain/web/static/vendor/*
!/brain/web/static/vendor/README.md
!/brain/web/static/vendor/dompurify.LICENSE
!/brain/web/static/vendor/js-yaml.LICENSE
!/brain/web/static/vendor/js-yaml.umd.min.js
!/brain/web/static/vendor/marked.LICENSE
!/brain/web/static/vendor/marked.umd.js
!/brain/web/static/vendor/purify.min.js

!/tests/
/tests/*
!/tests/test_auth.py
!/tests/test_context.py
!/tests/test_install.py
!/tests/test_mcp.py
!/tests/test_serve.py
!/tests/test_store.py
!/tests/test_web.py

# Safety net, kept last so it wins even if a rule above is widened later.
__pycache__/
*.pyc
.env
.env.*
*.key
*.pem
